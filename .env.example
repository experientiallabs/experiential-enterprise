# Experiential Labs platform local environment
# Copy this file to .env.local and fill in values for local runs.
# .env.local is intentionally ignored because it may contain secrets.

# Supabase local control plane.
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# FastAPI backend.
EXPLABS_API_KEY=
# Server-side URL the Next.js webapp uses to reach the FastAPI backend.
EXPLABS_BACKEND_URL=http://127.0.0.1:8030
# Comma-separated CORS origins the FastAPI API allows.
# EXPLABS_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Shared non-secret cache revision for the serving processes.
# Required in hosted deployments; bump it whenever Platform provider keys rotate.
# EXPLABS_PLATFORM_PROVIDER_REVISION=provider-2026-08-18
# Deterministic Project-serving acceptance fixture. Never configure these in
# production; local Compose supplies safe defaults and hosted smoke is opt-in.
# EXPLABS_PROJECT_SERVING_FIXTURE_MODE=deterministic-v1
# EXPLABS_PROJECT_SERVING_FIXTURE_PROJECT_ID=00000000-0000-4000-8000-0000000000a1
# EXPLABS_PROJECT_SERVING_FIXTURE_EMBEDDING_DIMENSION=3

# Supabase Storage bucket for trace uploads.
EXPLABS_STORAGE_BUCKET=explabs-artifacts

# OAuth provider credentials for local Supabase (supabase/config.toml reads
# these; also flip the matching [auth.external.*] enabled flags). Hosted
# projects configure providers in the Supabase dashboard instead.
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_GITHUB_SECRET=

# Seeded local admin login.
EXPLABS_AUTH_ADMIN_EMAIL=admin@xplabs.ai
EXPLABS_AUTH_ADMIN_PASSWORD=3XP321!

# Internal Project-serving connection. This key must differ from
# EXPLABS_API_KEY.
# EXPLABS_PROJECT_SERVING_BACKEND_URL=http://127.0.0.1:18083
# EXPLABS_PROJECT_SERVING_DEPLOYMENT_KEY=

# LLM-provider credentials consumed by the world-model harness in later phases.
# Tenants provide these per project via Supabase Vault; set locally only for dev.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# FIREWORKS_API_KEY=

# Azure OpenAI resource serving azure-backed world models (the platform default
# simulator, GPT-5.5). The key is the only environmental credential — endpoint,
# deployment, and api-version are threaded through the build config and the
# artifact's config.toml. AZURE_OPENAI_ENDPOINT is a build-time fallback for
# records that do not pin "endpoint" in their config payload.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# Azure AI Foundry credentials. Set both to serve models from your own
# Foundry resource; unset, the Foundry lane stays unavailable.
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_ENDPOINT=

# Invitation emails (admin panel). Without RESEND_API_KEY invites are created
# with no email; admins share the copy-link instead. The sender defaults to
# the verified members@experientiallabs.ai address.
# RESEND_API_KEY=
# EXPLABS_EMAIL_FROM="Experiential Labs <members@experientiallabs.ai>"

# Stripe credit top-ups (webapp). Without these the billing routes answer 503
# and everything else runs. Local verification: use the sk_test key, run
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`, and paste
# the whsec it prints. The webhook refuses events whose livemode does not
# match the key's mode, so never mix test and live values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Public origin for auth callback/OTP redirect URLs, Stripe return URLs, and
# error-message links; defaults to the request Host header when unset (fine
# locally, required hosted).
# EXPLABS_WEBAPP_URL=

# Auto-recharge poller (webapp). An external scheduler POSTs
# /api/internal/auto-recharge on an interval with `Authorization: Bearer
# $CRON_SECRET` to charge saved cards off-session when a balance runs low.
# Without CRON_SECRET the route answers 503 and auto-recharge simply never
# fires; manual top-ups are unaffected. The off-session flow needs a saved
# card, which only a consented Checkout produces — verify it live with a real
# Stripe test card and `stripe listen`.
# CRON_SECRET=
