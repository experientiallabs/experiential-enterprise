POSTGRES_PASSWORD=postgres
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

EXPLABS_WEB_HOST_PORT=3300
EXPLABS_API_HOST_PORT=18080
EXPLABS_SUPABASE_HOST_PORT=55421
EXPLABS_DB_HOST_PORT=55422
EXPLABS_STUDIO_HOST_PORT=55423
# Mailpit UI: auth emails land here — the email-code login's 6-digit
# sign-in codes above all. Open http://localhost:55424 to read them.
EXPLABS_MAILPIT_HOST_PORT=55424
# Gateway worker published to the host for worker-direct benchmarking and
# debugging (scripts/ci/gateway_load.sh). Local-only surface: hosted
# deployments keep the worker cluster-private behind the /v1 edge.
EXPLABS_GATEWAY_WORKER_HOST_PORT=18081
EXPLABS_API_KEY=local-explabs-api-key
EXPLABS_PROJECT_SERVING_DEPLOYMENT_KEY=local-explabs-project-serving-key
EXPLABS_RELEASE_FAULT_KEY=local-release-fault-key
# Bump when Platform-managed provider credentials rotate. Worker and private
# Project-serving must receive the exact same printable 1-128 character value.
EXPLABS_PLATFORM_PROVIDER_REVISION=local-provider-v1
# One project-scoped deterministic provider seam used only by the backend
# acceptance smoke. Core rejects it outside local/preview/staging.
EXPLABS_PROJECT_SERVING_FIXTURE_MODE=deterministic-v1
EXPLABS_PROJECT_SERVING_FIXTURE_PROJECT_ID=00000000-0000-4000-8000-0000000000a1
EXPLABS_PROJECT_SERVING_FIXTURE_EMBEDDING_DIMENSION=3
EXPLABS_AUTH_ADMIN_EMAIL=admin@xplabs.ai
EXPLABS_AUTH_ADMIN_PASSWORD=3XP321!

# Optional Docker Compose project name. integration_stack.sh derives a worktree-specific
# name when unset so parallel agents do not collide on the shared Docker host.
# EXPLABS_STACK_PROJECT_NAME=explabs-local

# Optional image tags for the locally built api/web images. integration_stack.sh
# rebuilds under these tags; parallel worktrees must set unique values or their
# builds overwrite each other's images (the compose project name does NOT
# namespace image tags).
# EXPLABS_API_IMAGE=explabs-local-api
# EXPLABS_WEB_IMAGE=explabs-local-web

# Optional registry prefix for the pinned third-party stack images (see
# docker/README.md). Unset means Docker Hub; CI points it at the GHCR mirrors.
# Keep this line commented: an empty assignment here would clobber a prefix
# exported by the environment, because integration_stack.sh sources this file
# with set -a after inheriting the process env.
# EXPLABS_STACK_REGISTRY_PREFIX=ghcr.io/experientiallabs/mirror/
